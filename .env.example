# Database
DATABASE_URL=mysql://user:password@localhost:3306/bolt_merchant_automation

# Manus AI API
MANUS_API_KEY=your_manus_api_key_here
MANUS_API_URL=https://api.manus.im/v1
MANUS_OAUTH_CLIENT_ID=your_oauth_client_id
MANUS_OAUTH_CLIENT_SECRET=your_oauth_client_secret

# Slack Integration
SLACK_API_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL_SALES_OPS=#sales-ops
SLACK_CHANNEL_SALES_MANAGER=#sales-manager

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@bolt.eu

# AWS S3 (for contracts)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=eu-west-1
AWS_S3_BUCKET=bolt-merchant-contracts

# Application
NODE_ENV=development
PORT=3000
JWT_SECRET=your_jwt_secret_here

# Validation Configuration
CONFIDENCE_THRESHOLD=90
SALES_OPS_SLA_HOURS=2
VALIDATION_REPORT_TIME=09:00
