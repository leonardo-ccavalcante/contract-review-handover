{
  "name": "bolt-merchant-validation",
  "version": "1.0.0",
  "description": "Pre-Contract Validation System (Hard Gate) for Bolt Merchant Onboarding",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "tsc && vite build",
    "build:server": "tsc",
    "start": "node dist/server/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.19.2",
    "@trpc/server": "^11.0.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "drizzle-orm": "^0.33.0",
    "mysql2": "^3.11.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^14.1.0",
    "i18next": "^23.11.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "tailwindcss": "^4.0.0",
    "@tanstack/react-query": "^5.28.0",
    "zod": "^3.23.0",
    "winston": "^3.13.0",
    "nodemailer": "^6.9.13",
    "@slack/web-api": "^7.0.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "date-fns": "^3.6.0",
    "clsx": "^2.1.0",
    "pdfjs-dist": "^4.4.168",
    "react-router-dom": "^6.23.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "vite": "^5.2.10",
    "vitest": "^1.5.0",
    "@vitejs/plugin-react": "^4.2.1",
    "drizzle-kit": "^0.24.0",
    "@types/node": "^20.12.7",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/nodemailer": "^6.4.15",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "tsx": "^4.7.2",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.7.1",
    "@typescript-eslint/parser": "^7.7.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "@types/uuid": "^10.0.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  }
}
